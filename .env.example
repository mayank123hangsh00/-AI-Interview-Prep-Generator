# ===========================================
# AI Interview Prep Kit — Environment Variables
# ===========================================

# LLM Provider selection: 'groq' | 'gemini' | 'openai'
LLM_PROVIDER=groq

# Groq API Configuration (https://console.groq.com/keys)
GROQ_API_KEY=gsk_your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Google Gemini API Key (free tier from Google AI Studio)
# Get yours at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (optional)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini

# MongoDB connection string (MongoDB Atlas free M0 cluster)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/interview-prep

# JWT secret for authentication tokens
JWT_SECRET=your_jwt_secret_here_change_this_to_a_long_random_string

# Server configuration
PORT=3001
NODE_ENV=development

# Client URL (for CORS)
CLIENT_URL=http://localhost:3000

# Server URL (for client API calls)
NEXT_PUBLIC_API_URL=http://localhost:3001
